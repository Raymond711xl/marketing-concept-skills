{
  "name": "marketing-concept-skill",
  "display_name": "慢策",
  "english_display_name": "Marketing Concept Skill",
  "slogan": "写方案的前半程，有 AI 陪你慢慢跑。",
  "version": "0.8.9",
  "status": "draft-alpha",
  "license": "MIT",
  "default_language": "zh-CN",
  "default_market_context": "China / Chinese web",
  "entry_skill": "concept-strategy-controller",
  "plugin_root": "plugins/marketing-concept-skill",
  "core_flow": [
    "Brief",
    "Evidence Collection",
    "Evidence Summary",
    "Insight Strategy",
    "Idea Platform",
    "Concept"
  ],
  "skills": [
    {
      "name": "concept-strategy-controller",
      "role": "controller",
      "path": "plugins/marketing-concept-skill/skills/concept-strategy-controller"
    },
    {
      "name": "web-evidence-collector",
      "role": "evidence_collection",
      "path": "plugins/marketing-concept-skill/skills/web-evidence-collector"
    },
    {
      "name": "evidence-summary-analysis",
      "role": "evidence_summary",
      "path": "plugins/marketing-concept-skill/skills/evidence-summary-analysis"
    },
    {
      "name": "insight-strategy",
      "role": "insight_strategy",
      "path": "plugins/marketing-concept-skill/skills/insight-strategy"
    }
  ],
  "stage_commands": [
    "进入：证据采集",
    "进入：证据摘要",
    "进入：策略洞察",
    "进入：Idea Platform",
    "进入：Concept",
    "查看：资料池",
    "回退到：证据摘要",
    "继续"
  ],
  "distribution": {
    "codex_manifest": "plugins/marketing-concept-skill/.codex-plugin/plugin.json",
    "codex_marketplace": ".agents/plugins/marketplace.json",
    "claude_manifest": "plugins/marketing-concept-skill/.claude-plugin/plugin.json",
    "claude_marketplace": ".claude-plugin/marketplace.json",
    "release_artifact": "dist/marketing-concept-skills-0.8.9.zip"
  },
  "validation": {
    "codex": "extracted-bundle-install-passed",
    "claude_code": "extracted-bundle-install-passed"
  },
  "migration": {
    "planned_targets": [
      "Chinese IDE / Agent software"
    ],
    "future_shared_references": [
      "shared-references/chinese-working-protocol.md"
    ]
  }
}
